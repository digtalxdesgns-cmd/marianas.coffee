NEXT_PUBLIC_SHOP_URL=https://shop.marianascoffee.com

# Optional server-only WooCommerce origin override (e.g. isolated staging URL).
# WOOCOMMERCE_URL=https://regionaltest.shop.marianascoffee.com

# Optional server-only HTTP Basic Auth credentials when staging uses Hostinger
# directory password protection. Never prefix with NEXT_PUBLIC_.
# WOOCOMMERCE_STAGING_USER=
# WOOCOMMERCE_STAGING_PASS=

# Optional upstream Store API timeout in milliseconds (1000..15000).
# WOOCOMMERCE_FETCH_TIMEOUT_MS=8000
